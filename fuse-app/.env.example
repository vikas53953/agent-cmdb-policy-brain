# Fuse — optional API credentials.
# The app runs fully in "demo mode" with NO keys (YouTube IFrame playback + demo catalog).
# Add keys to unlock real cross-service search and Spotify playback.
#
# Copy this file to `.env.local` and fill in the values you have.

# --- YouTube Data API v3 (enables real search across YouTube) ---
# Create a key at https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=

# --- Spotify (enables Spotify search + playback; playback needs a Premium account) ---
# Register an app at https://developer.spotify.com/dashboard
# Add http://localhost:5173/callback as a Redirect URI.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback
