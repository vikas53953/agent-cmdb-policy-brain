# Fuse — environment variables (template).
#
# Copy this file to `.env.local` and fill in the values you have. The app
# TYPECHECKS, TESTS, and BUILDS with NONE of these set — every access is guarded
# and features degrade to an honest disabled state at runtime rather than
# crashing. Never commit real values; `.env.local` stays in `.gitignore`.
#
# NOTE: secrets belong ONLY in `.env.local` / Vercel project settings. Nothing
# here is a real key — these are empty placeholders.

# --- Auth.js (U2) ---------------------------------------------------------------
# Session encryption secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth provider (Google Cloud Console → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database (U3) --------------------------------------------------------------
# Neon Postgres connection string.
DATABASE_URL=

# --- YouTube Data API v3 (U6/U7) ------------------------------------------------
# Server-side key for search.list / videos.list. Never exposed to the browser.
YOUTUBE_API_KEY=

# --- Spotify (U6 search / U15 playback) -----------------------------------------
# Client id is used by BOTH the browser PKCE connect flow (U15, public) and the
# server-side search token exchange (U6).
SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Server-side SEARCH (U6) uses the Client Credentials flow, which needs the secret
# in addition to the id. Server-only — never exposed to the browser. The PKCE
# connect flow (U15) does not use this. Search degrades to an honest disabled
# state when it is unset.
SPOTIFY_CLIENT_SECRET=

# --- Public origin --------------------------------------------------------------
# Used to build OAuth / PKCE redirect URIs. e.g. http://localhost:3000
NEXT_PUBLIC_BASE_URL=
